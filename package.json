{
  "name": "voxweaver",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.0 <24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run lint && pnpm run build && pnpm run test",
    "clean": "pnpm -r --if-present run clean",
    "lint": "pnpm run lint:js && pnpm run typecheck",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm run build && pnpm -r --if-present run typecheck:source"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-plugin-format": "2.0.1",
    "globals": "17.9.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3"
  }
}
