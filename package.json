{
  "name": "voxweaver",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=11.5.2 <12"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @voxweaver/desktop start",
    "dev:debug": "VOXWEAVER_OPEN_DEVTOOLS=1 corepack pnpm --filter @voxweaver/desktop start",
    "start": "corepack pnpm run dev",
    "package": "corepack pnpm --filter @voxweaver/desktop package",
    "make": "corepack pnpm --filter @voxweaver/desktop make",
    "clean": "rimraf apps/desktop/.vite apps/desktop/renderer/.vite apps/desktop/out",
    "lint": "corepack pnpm run lint:js:check && corepack pnpm run lint:style:check",
    "lint:fix": "corepack pnpm run lint:js:fix && corepack pnpm run lint:style:fix",
    "lint:js:check": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:style:check": "stylelint 'apps/desktop/renderer/src/**/*.{css,vue}'",
    "lint:style:fix": "stylelint 'apps/desktop/renderer/src/**/*.{css,vue}' --fix",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test": "corepack pnpm -r --if-present run test",
    "check:pages": "corepack pnpm --filter @voxweaver/desktop run check:pages",
    "check": "corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run check:pages",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "postcss-html": "2.0.0",
    "rimraf": "6.1.3",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.2.0",
    "typescript": "6.0.3"
  }
}
