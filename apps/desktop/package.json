{
  "name": "@voxweaver/desktop",
  "productName": "VoxWeaver",
  "version": "0.0.0",
  "private": true,
  "description": "VoxWeaver Electron desktop application",
  "main": ".webpack/main",
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --noEmit",
    "clean": "rimraf .webpack out",
    "package": "rimraf out && electron-forge package --platform=darwin --arch=arm64",
    "start": "electron-forge start",
    "test:e2e": "node test/e2e/desktop.e2e.mjs",
    "verify:phase-00": "pnpm run package && pnpm run test:e2e",
    "test": "node test/securityBaseline.mjs && tsc -p test/tsconfig.core-tests.json && node --test test/core/*.test.mjs test/main/*.test.mjs test/renderer/*.test.mjs && rimraf test/.generated",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "typecheck:source": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@voxweaver/app-core": "workspace:*",
    "@voxweaver/contracts": "workspace:*",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@playwright/test": "1.62.1",
    "@vue/compiler-sfc": "3.5.41",
    "css-loader": "7.1.4",
    "electron": "43.2.0",
    "rimraf": "6.1.3",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "vue-loader": "17.4.2",
    "vue-tsc": "3.3.9",
    "webpack": "5.109.2"
  }
}
