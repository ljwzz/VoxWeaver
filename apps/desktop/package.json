{
  "name": "@voxweaver/desktop",
  "productName": "VoxWeaver",
  "type": "commonjs",
  "version": "0.1.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "PNPM_CONFIG_PM_ON_FAIL=warn electron-forge start",
    "package": "PNPM_CONFIG_PM_ON_FAIL=warn electron-forge package --platform=darwin --arch=arm64",
    "make": "PNPM_CONFIG_PM_ON_FAIL=warn electron-forge make --platform=darwin --arch=arm64",
    "check:pages": "node scripts/check-pages.mjs",
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --project tsconfig.main.json --noEmit && vue-tsc --project tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lucide/vue": "1.31.0",
    "@voxweaver/app-core": "workspace:*",
    "@voxweaver/contracts": "workspace:*",
    "@voxweaver/novel-import": "workspace:*",
    "element-plus": "2.14.4",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "electron": "43.3.0",
    "happy-dom": "20.11.2",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
