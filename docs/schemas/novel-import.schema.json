{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxweaver.local/schemas/novel-import.schema.json",
  "title": "VoxWeaver novel import and structure documents",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/importedNovelV1"
    },
    {
      "$ref": "#/$defs/chapterIndexV1"
    },
    {
      "$ref": "#/$defs/sceneIndexV1"
    },
    {
      "$ref": "#/$defs/processingSegmentIndexV1"
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "sourceByteRangeV1": {
      "type": "object",
      "required": [
        "offsetUnit",
        "startByte",
        "endByte"
      ],
      "properties": {
        "offsetUnit": {
          "const": "source-byte"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "sourceLineRangeV1": {
      "type": "object",
      "required": [
        "lineBase",
        "startLine",
        "endLineExclusive"
      ],
      "properties": {
        "lineBase": {
          "const": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "endLineExclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "txtEncodingDecisionV1": {
      "type": "object",
      "required": [
        "sourceContentHash",
        "sourceEncoding",
        "method"
      ],
      "properties": {
        "sourceContentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceEncoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "gbk",
            "gb18030",
            "big5",
            "utf-16le",
            "utf-16be"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "bom",
            "strict-utf8",
            "user"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "method": {
              "const": "bom"
            },
            "sourceEncoding": {
              "type": "string",
              "enum": [
                "utf-8",
                "utf-16le",
                "utf-16be"
              ]
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "strict-utf8"
            },
            "sourceEncoding": {
              "const": "utf-8"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "user"
            },
            "sourceEncoding": {
              "type": "string",
              "enum": [
                "gbk",
                "gb18030",
                "big5",
                "utf-16le",
                "utf-16be"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "txtSourceLocatorV1": {
      "type": "object",
      "required": [
        "sourceAssetId",
        "sourceContentHash",
        "sourceEncoding",
        "sourceByteRange",
        "rawTextRange",
        "lineRange"
      ],
      "properties": {
        "sourceAssetId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "sourceContentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceEncoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "gbk",
            "gb18030",
            "big5",
            "utf-16le",
            "utf-16be"
          ]
        },
        "sourceByteRange": {
          "$ref": "#/$defs/sourceByteRangeV1"
        },
        "rawTextRange": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "lineRange": {
          "$ref": "#/$defs/sourceLineRangeV1"
        }
      },
      "additionalProperties": false
    },
    "novelMetadataV1": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "documentBlockV1": {
      "type": "object",
      "required": [
        "blockId",
        "kind",
        "rawText",
        "sourceLocator",
        "contentHash"
      ],
      "properties": {
        "blockId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "heading",
            "paragraph",
            "quote",
            "list",
            "separator",
            "unknown"
          ]
        },
        "rawText": {
          "type": "string",
          "minLength": 1
        },
        "sourceLocator": {
          "$ref": "#/$defs/txtSourceLocatorV1"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "structuralHintV1": {
      "type": "object",
      "required": [
        "kind",
        "rawValue",
        "sourceLocator",
        "reviewStatus"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "rawValue": {
          "type": "string"
        },
        "sourceLocator": {
          "$ref": "#/$defs/txtSourceLocatorV1"
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "importIssueV1": {
      "type": "object",
      "required": [
        "issueId",
        "code",
        "severity",
        "reviewStatus",
        "message"
      ],
      "properties": {
        "issueId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "NOVEL_IMPORT_UNSUPPORTED_FORMAT",
            "NOVEL_IMPORT_INVALID_SOURCE",
            "NOVEL_IMPORT_ENCODING_REQUIRED",
            "NOVEL_IMPORT_STRUCTURE_INVALID",
            "NOVEL_IMPORT_REVIEW_REQUIRED",
            "NOVEL_IMPORT_STALE_SESSION",
            "NOVEL_IMPORT_DEPENDENCY_UNAVAILABLE",
            "NOVEL_IMPORT_RESOURCE_LIMIT_EXCEEDED",
            "NOVEL_IMPORT_BUDGET_INVALID"
          ]
        },
        "detailReason": {
          "type": "string",
          "minLength": 1
        },
        "textRange": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "sourceLocator": {
          "$ref": "#/$defs/txtSourceLocatorV1"
        },
        "sourceEncoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "gbk",
            "gb18030",
            "big5",
            "utf-16le",
            "utf-16be"
          ]
        },
        "sourceByteRange": {
          "$ref": "#/$defs/sourceByteRangeV1"
        }
      },
      "additionalProperties": true
    },
    "importedNovelV1": {
      "type": "object",
      "required": [
        "documentType",
        "schemaVersion",
        "sourceAssetId",
        "sourceHash",
        "sourceByteLength",
        "sourceFormat",
        "encodingDecision",
        "adapterId",
        "adapterVersion",
        "processorId",
        "processorVersion",
        "alignmentPolicyVersion",
        "rawTextRevision",
        "metadata",
        "orderedBlocks",
        "structuralHints",
        "warnings",
        "reviewStatus"
      ],
      "properties": {
        "documentType": {
          "const": "imported-novel"
        },
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "sourceAssetId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceByteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceFormat": {
          "const": "txt"
        },
        "encodingDecision": {
          "$ref": "#/$defs/txtEncodingDecisionV1"
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "processorId": {
          "type": "string",
          "minLength": 1
        },
        "processorVersion": {
          "type": "string",
          "minLength": 1
        },
        "alignmentPolicyVersion": {
          "const": "m1-block-alignment-v1"
        },
        "rawTextRevision": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRevisionRefV1"
        },
        "metadata": {
          "$ref": "#/$defs/novelMetadataV1"
        },
        "orderedBlocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/documentBlockV1"
          }
        },
        "structuralHints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structuralHintV1"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/importIssueV1"
          }
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": true
    },
    "chapterCandidateV1": {
      "type": "object",
      "required": [
        "chapterCandidateId",
        "headingRange",
        "lineRange",
        "rawTitle",
        "normalizedTitle",
        "ruleId",
        "ruleVersion",
        "ruleConfidence",
        "confidenceSource",
        "evidence",
        "contextBefore",
        "contextAfter",
        "reviewStatus"
      ],
      "properties": {
        "chapterCandidateId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "headingRange": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "lineRange": {
          "$ref": "#/$defs/sourceLineRangeV1"
        },
        "rawTitle": {
          "type": "string",
          "minLength": 1
        },
        "normalizedTitle": {
          "type": "string",
          "minLength": 1
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1
        },
        "ruleConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidenceSource": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contextBefore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contextAfter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "chapterIndexEntryV1": {
      "type": "object",
      "required": [
        "chapterId",
        "order",
        "title",
        "rawHeading",
        "headingRange",
        "contentRange",
        "sourceLineRange",
        "confidence",
        "detectedBy",
        "reviewStatus"
      ],
      "properties": {
        "chapterId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "volumeId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "volumeNumber": {
          "type": "string",
          "minLength": 1
        },
        "chapterNumber": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rawHeading": {
          "type": "string",
          "minLength": 1
        },
        "headingRange": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "contentRange": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "sourceLineRange": {
          "$ref": "#/$defs/sourceLineRangeV1"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "detectedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "coverageSegmentV1": {
      "type": "object",
      "required": [
        "classification",
        "range"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "front_matter",
            "chapter",
            "appendix",
            "noise",
            "unknown"
          ]
        },
        "range": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "chapterId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "classification": {
              "const": "chapter"
            }
          },
          "required": [
            "chapterId"
          ]
        },
        {
          "properties": {
            "classification": {
              "type": "string",
              "enum": [
                "front_matter",
                "appendix",
                "noise",
                "unknown"
              ]
            }
          },
          "not": {
            "required": [
              "chapterId"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "coverageReportV1": {
      "type": "object",
      "required": [
        "textRevisionId",
        "textLayer",
        "totalByteLength",
        "classifiedByteLength",
        "unclassifiedByteLength",
        "complete",
        "segments",
        "unclassifiedRanges"
      ],
      "properties": {
        "textRevisionId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "textLayer": {
          "const": "canonical"
        },
        "totalByteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "classifiedByteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unclassifiedByteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "type": "boolean"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageSegmentV1"
          }
        },
        "unclassifiedRanges": {
          "type": "array",
          "items": {
            "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
          }
        }
      },
      "additionalProperties": false
    },
    "chapterIndexV1": {
      "type": "object",
      "required": [
        "documentType",
        "schemaVersion",
        "sourceAssetId",
        "sourceHash",
        "processorId",
        "processorVersion",
        "textRevision",
        "candidates",
        "entries",
        "coverageReport",
        "issues",
        "reviewStatus"
      ],
      "properties": {
        "documentType": {
          "const": "chapter-index"
        },
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "sourceAssetId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "processorId": {
          "type": "string",
          "minLength": 1
        },
        "processorVersion": {
          "type": "string",
          "minLength": 1
        },
        "textRevision": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRevisionRefV1"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapterCandidateV1"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapterIndexEntryV1"
          }
        },
        "coverageReport": {
          "$ref": "#/$defs/coverageReportV1"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/importIssueV1"
          }
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": true
    },
    "sceneBoundaryCandidateV1": {
      "type": "object",
      "required": [
        "sceneBoundaryCandidateId",
        "chapterId",
        "blockId",
        "reasons",
        "evidenceRange",
        "proposedBoundary",
        "sourceLocator",
        "ruleId",
        "ruleVersion",
        "evidence",
        "reviewStatus"
      ],
      "properties": {
        "sceneBoundaryCandidateId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "chapterId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "blockId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "explicit_separator",
              "time_change",
              "location_change",
              "viewpoint_change",
              "event_change",
              "memory_transition",
              "dream_transition"
            ]
          }
        },
        "evidenceRange": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "proposedBoundary": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "appliedBoundary": {
          "$ref": "https://voxweaver.local/schemas/text-reference.schema.json#/$defs/textRangeV1"
        },
        "sourceLocator": {
          "$ref": "#/$defs/txtSourceLocatorV1"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "reviewStatus": {
              "type": "string",
              "enum": [
                "not_required",
                "approved"
              ]
            }
          },
          "required": [
            "appliedBoundary"
          ]
        },
        {
          "properties": {
            "reviewStatus": {
              "type": "string",
              "enum": [
                "pending",
                "rejected"
              ]
            }
          },
          "not": {
            "required": [
              "appliedBoundary"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "sceneBlockReferenceV1": {
      "type": "object",
      "required": [
        "blockId",
        "range",
        "sourceLocator"
      ],
      "properties": {
        "blockId": {
          "type": "string",
