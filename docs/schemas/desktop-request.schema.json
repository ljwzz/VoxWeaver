{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxweaver.local/schemas/desktop-request.schema.json",
  "title": "VoxWeaver desktop request envelope",
  "type": "object",
  "required": [
    "protocolVersion",
    "requestId",
    "method",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "projectContext": {
      "type": "object",
      "required": [
        "projectId",
        "projectSessionId"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "projectSessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "$ref": "#/$defs/jsonValue"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
