{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxweaver.local/schemas/artifact-revision.schema.json",
  "title": "VoxWeaver artifact revision document",
  "type": "object",
  "required": [
    "schemaVersion",
    "record",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "record": {
      "$ref": "https://voxweaver.local/schemas/artifact-record.schema.json"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "producerArtifactId",
          "producerRevisionId",
          "dependencyType"
        ],
        "properties": {
          "producerArtifactId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "producerRevisionId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "dependencyType": {
            "type": "string",
            "enum": [
              "content",
              "structure",
              "voice",
              "pronunciation",
              "config"
            ]
          },
          "selector": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "chapterIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "blockIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "scriptUnitIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "voiceProfileIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "dictionaryEntryIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
